
# CampusRelay AI - Environment Configuration
# Copy this file to .env for local configuration.
# Never commit a real .env file.

# Application
APP_ENV=development
ENABLE_DEMO_DATA=true

# Database
DATABASE_PATH=instance/campusrelay.db

# Authentication and cookies
COOKIE_SECURE=false

# Optional security settings
ALLOWED_ORIGINS=
TRUSTED_HOSTS=

# Optional admin account bootstrap
# Never place real credentials in this example.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
